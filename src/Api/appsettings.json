{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/binancebot-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=BinanceBot;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Admin": {
    "Key": "dev-admin-key-change-me"
  },
  "Binance": {
    "RestBaseUrl": "https://testnet.binance.vision",
    "WsBaseUrl": "wss://stream.testnet.binance.vision",
    "Symbols": [ "BTCUSDT", "ETHUSDT", "XRPUSDT", "SOLUSDT", "ADAUSDT" ],
    "KlineIntervals": [ "5m" ],
    "DepthSnapshotLimit": 1000,
    "RestTimeoutMs": 10000,
    "WsReconnectInitialDelayMs": 500,
    "WsReconnectMaxDelayMs": 30000,
    "WsPingIntervalMs": 20000,
    "WsPongTimeoutMs": 60000,
    "BackfillEnabled": true,
    "BackfillLimit": 1000,
    "BackfillIntervals": [ "5m" ],
    "AllowMainnet": false
  },
  "PaperFill": {
    "FixedSlippagePct": 0.0001,
    "SimulatedLatencyMs": 100,
    "UseBnbFeeDiscount": true
  },
  "BreakEven": {
    "Enabled": true,
    "TriggerPct": 0.0010,
    "OffsetPct": 0.0002
  },
  "TrailingStop": {
    "Enabled": true,
    "TrailPct": 0.0015
  },
  "RiskProfile": {
    "Defaults": {
      "RiskPerTradePct": 0.02,
      "MaxPositionSizePct": 0.40,
      "MaxDrawdown24hPct": 0.03,
      "MaxDrawdownAllTimePct": 0.10,
      "MaxConsecutiveLosses": 5,
      "MaxOpenPositions": 5
    }
  },
  "Strategies": {
    "Seed": [
